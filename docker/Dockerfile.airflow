FROM apache/airflow:2.9.3-python3.11

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Le projet est monté depuis l'hôte : git doit accepter ce dossier pour que
# chaque run MLflow garde la trace du commit.
RUN git config --system --add safe.directory /opt/airflow/project

USER airflow

COPY requirements-airflow.txt /requirements-airflow.txt

# Sur un poste dont l'antivirus ou le proxy inspecte le HTTPS, son autorité de
# certification peut être fournie au build (secret « pip_ca ») ; sinon rien ne change.
RUN --mount=type=secret,id=pip_ca,mode=0444 \
    if [ -s /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi \
    && pip install --no-cache-dir -r /requirements-airflow.txt
