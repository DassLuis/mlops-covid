FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Le projet est monté depuis l'hôte : git doit accepter ce dossier pour que
# chaque run MLflow garde la trace du commit.
RUN git config --system --add safe.directory /app

WORKDIR /app

COPY requirements-training.txt .

# Sur un poste dont l'antivirus ou le proxy inspecte le HTTPS, son autorité de
# certification peut être fournie au build (secret « pip_ca ») ; sinon rien ne change.
RUN --mount=type=secret,id=pip_ca,mode=0444 \
    if [ -s /run/secrets/pip_ca ]; then export PIP_CERT=/run/secrets/pip_ca; fi \
    && pip install --no-cache-dir -r requirements-training.txt

COPY api/auth.py api/auth.py
COPY src/ src/
COPY training/ training/
COPY dvc.yaml dvc.lock ./

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "training.app:app", "--host", "0.0.0.0", "--port", "8000"]
