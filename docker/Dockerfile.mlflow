FROM python:3.11-slim

WORKDIR /mlflow

RUN pip install --no-cache-dir mlflow==3.16.0

EXPOSE 5000

# --serve-artifacts : les clients (Airflow, API, poste local) envoient et lisent
# les modèles via le serveur, sans partager de dossier avec lui.
CMD ["mlflow", "server", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--serve-artifacts", "--artifacts-destination", "/mlflow/artifacts", "--default-artifact-root", "mlflow-artifacts:/", "--host", "0.0.0.0", "--port", "5000", "--allowed-hosts", "*"]
